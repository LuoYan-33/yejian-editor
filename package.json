{
  "name": "yejian-editor",
  "version": "1.3.0",
  "description": "页间 Markdown 编辑器",
  "author": "页间",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "predist": "node node_modules/electron/install.js",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "predist:mac": "node node_modules/electron/install.js",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "test:desktop": "npm run build && node tests/desktop.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "cn.yejian.markdown.editor",
    "productName": "页间",
    "publish": {
      "provider": "github",
      "owner": "LuoYan-33",
      "repo": "yejian-editor"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "ui-dist/**/*",
      "package.json"
    ],
    "win": {
      "executableName": "Yejian",
      "icon": "assets/yejian.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/yejian.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "notarize": false,
      "fileAssociations": [{ "ext": ["md", "markdown", "mdown", "mkd"], "name": "Markdown 文档", "role": "Editor", "rank": "Alternate" }]
    },
    "dmg": {
      "artifactName": "Yejian-Mac-${version}-${arch}.dmg"
    },
    "nsis": {
      "include": "scripts/installer.nsh",
      "artifactName": "Yejian-Setup-${version}-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "页间 Markdown 编辑器",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "Yejian-Portable-${version}-x64.exe"
    }
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "dompurify": "3.4.18",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "markdown-it": "15.0.3",
    "playwright-core": "1.65.1"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
